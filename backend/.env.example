# Required API Keys
# Shared, free government data credential; keep on the server.
GOV_API_KEY=
# Local use only. PUBLIC_MODE ignores all host model and embedding keys.
OPENAI_API_KEY=
PUBLIC_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Settings
OPENAI_MODEL=gpt-6.1-sol
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/pipeline/feature-extraction
PORT=8000

# RAG / PDF Memory
RAG_PERSIST_DIR=./chroma
RAG_COLLECTION=pdf_memory
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MAX_CHUNKS=500
RAG_TOP_K=5
