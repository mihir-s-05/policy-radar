{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "policy-radar",
  "account_id": "35285b92cc8a889b1e38627664901535",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "policy.mihir-s.com", "custom_domain": true }],
  "ratelimits": [
    { "name": "BURST_LIMIT", "namespace_id": "11011001", "simple": { "limit": 80, "period": 60 } },
    { "name": "EMBEDDING_BURST_LIMIT", "namespace_id": "11011002", "simple": { "limit": 40, "period": 60 } },
    { "name": "SHARED_BURST_LIMIT", "namespace_id": "11011003", "simple": { "limit": 240, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "policy-radar-public",
    "database_id": "8c92786f-6d78-445e-8fbe-cf309c8ce046",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "EMBEDDINGS_ENABLED": "true",
    "EMBEDDING_DAILY_BUDGET": "4000",
    "GOV_HOURLY_BUDGET": "800",
    "GOV_DAILY_BUDGET": "4000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
